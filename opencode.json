{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "supabase": {
        "type": "local",
        "command": ["npx", "-y", "@supabase/mcp-server-supabase"],
        "environment": {
          "SUPABASE_ACCESS_TOKEN": "{env:SUPABASE_ACCESS_TOKEN}"
        }
      },
      "firebase": {
        "type": "local",
        "command": ["npx", "-y", "firebase-tools", "mcp"],
        "timeout": { "startup": 120000 }
      },
      "netlify": {
        "type": "local",
        "command": ["npx", "-y", "@netlify/mcp"],
        "environment": {
          "NETLIFY_AUTH_TOKEN": "{env:NETLIFY_AUTH_TOKEN}"
        }
      }
    }
  }
}

{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": ""
      }
    },
    "firebase": {
      "command": "npx",
      "args": [
        "-y",
        "firebase-tools",
        "mcp"
      ]
    },
    "netlify": {
      "command": "npx",
      "args": [
        "-y",
        "@netlify/mcp"
      ],
      "env": {
        "NETLIFY_AUTH_TOKEN": ""
      }
    }
  }
}

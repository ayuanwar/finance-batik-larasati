# Supabase Configuration
# Dapatkan nilai ini dari Dashboard Supabase Anda: Settings -> API

# URL Project Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci Anon/Public Supabase (aman digunakan di browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Kunci Service Role Supabase (HANYA digunakan di Server/Backend, JANGAN diekspos ke client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Configuration
# Dapatkan nilai ini dari Dashboard Supabase Anda: Settings -> API

# URL Project Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci Anon/Public Supabase (aman digunakan di browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Kunci Service Role Supabase (HANYA digunakan di Server/Backend, JANGAN diekspos ke client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# Resend Email Configuration (https://resend.com)
# ==============================================================================
# Dapatkan API Key dari https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Alamat Pengirim Resmi (Gunakan onboarding@resend.dev untuk pengujian gratis,
# atau gunakan alamat domain yang telah diverifikasi di Resend)
RESEND_FROM_EMAIL="CV Batik Larasati <onboarding@resend.dev>"

# Base URL Aplikasi (Digunakan untuk link tombol aksi pada email)
NEXT_PUBLIC_APP_URL=http://localhost:3000
